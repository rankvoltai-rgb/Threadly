# Copy to .env.local for local development.

# Apify — Threads scraping
APIFY_TOKEN=apify_api_xxx
APIFY_THREADS_ACTOR=automation-lab~threads-scraper

# Signs the licence cookie. Any long random string; must stay stable.
LICENSE_SECRET=change-me

# Stripe — a plain secret key from dashboard.stripe.com/apikeys.
# No marketplace/integration required.
STRIPE_SECRET_KEY=sk_test_xxx

# Convex — written by `npx convex dev`. Leave unset to run in cookie-only mode.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Production only (Render build): a prod deploy key from the Convex dashboard.
CONVEX_DEPLOY_KEY=
